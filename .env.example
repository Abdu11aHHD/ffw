# Sukkar Plus — environment template. PLACEHOLDERS ONLY. Never commit real values.
#
# This file documents the whole project. The services read their own files:
#   backend/.env   (see backend/.env.example)  — server secrets
#   web/.env       (see web/.env.example)      — public build-time config
#
# ── Backend (server side only) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key. NEVER place this in web/ or in any browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports

# Optional. Without it, extraction stays deterministic and Arabic summaries
# come from local templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

ENVIRONMENT=demo
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=15728640
STORE_REPORT_FILES=true
REPORT_RETENTION_DAYS=180

# ── Website (public, compiled into the bundle) ───────────────────────────
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000

# AI analysis provider (backend only)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
