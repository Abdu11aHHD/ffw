# Sukkar Plus backend — PLACEHOLDERS ONLY. Never commit real values.
# Copy to backend/.env and fill in for live mode. Leave empty for demo mode.

# ── Supabase (server side) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key. Server only. NEVER ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports

# ── Gemini (server side) ─────────────────────────────────────────────────
# Optional. Without it the API still works: extraction stays deterministic
# and Arabic summaries come from local templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=demo
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_BYTES=15728640
STORE_REPORT_FILES=true
REPORT_RETENTION_DAYS=180

# AI analysis provider (backend only)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
